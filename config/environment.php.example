<?php
/**
 * Configuración de Ambientes - PLANTILLA
 * Sistema GASELAG - Retiros de Medidores
 * 
 * ⚠️ INSTRUCCIONES DE INSTALACIÓN:
 * 
 * 1. Copiar este archivo como 'environment.php':
 *    - En Windows: copy environment.php.example environment.php
 *    - En Linux: cp environment.php.example environment.php
 * 
 * 2. Editar environment.php y configurar tus credenciales reales
 * 
 * 3. En DESARROLLO (localhost): define('ENVIRONMENT', 'development');
 *    En PRODUCCIÓN (hosting): define('ENVIRONMENT', 'production');
 * 
 * 4. NUNCA subir environment.php al repositorio (ya está en .gitignore)
 * 
 * Este archivo permite que el mismo código funcione en ambos ambientes
 * solo cambiando una línea.
 */

// ==========================================
// CONFIGURAR AMBIENTE ACTUAL
// ==========================================
// Cambiar a 'production' cuando subas a hosting
define('ENVIRONMENT', 'production');
// ==========================================

// Configuraciones por ambiente
$config = [
    // Ambiente de Desarrollo (localhost con XAMPP)
    'development' => [
        'db_host' => 'localhost',
        'db_port' => '3307',              // Puerto MySQL en XAMPP (puede ser 3306)
        'db_user' => 'root',              // Usuario de desarrollo
        'db_pass' => '',                  // Contraseña de desarrollo
        'db_name' => 'gaselag_retiros',
        'base_url' => 'http://localhost/form%20gaselag%20retiros/',
        'debug' => true,                  // Mostrar errores en desarrollo
        'display_errors' => true,
        'session_timeout' => 7200,        // 2 horas
        'upload_path' => '../uploads/',
        'timezone' => 'America/Lima'      // Ajustar según tu zona horaria
    ],
    
    // Ambiente de Producción (Hosting cPanel)
    'production' => [
        'db_host' => 'localhost',         // Generalmente localhost en cPanel
        'db_port' => '3306',              // Puerto estándar
        'db_user' => 'gaselagc_usuario_admin',    // ⚠️ CAMBIAR: Usuario de MySQL en cPanel
        'db_pass' => 'ml~*UU#-LJJ!9&8^',   // ⚠️ CAMBIAR: Contraseña de MySQL
        'db_name' => 'gaselagc_sistema_retiro',   // ⚠️ CAMBIAR: Nombre de la BD en cPanel
        'base_url' => 'https://www.gaselag.com/retiros/', // ⚠️ CAMBIAR: URL de producción
        'debug' => true,                 // NO mostrar errores en producción
        'display_errors' => true,
        'session_timeout' => 3600,        // 1 hora (más seguro en producción)
        'upload_path' => '../uploads/',
        'timezone' => 'America/Lima'
    ]
];

// Obtener configuración activa
if (!isset($config[ENVIRONMENT])) {
    die('Error: Ambiente no configurado correctamente. Revisar config/environment.php');
}

$activeConfig = $config[ENVIRONMENT];

// Definir constantes globales
define('DB_HOST', $activeConfig['db_host']);
define('DB_PORT', $activeConfig['db_port']);
define('DB_USER', $activeConfig['db_user']);
define('DB_PASS', $activeConfig['db_pass']);
define('DB_NAME', $activeConfig['db_name']);
define('BASE_URL', $activeConfig['base_url']);
define('DEBUG_MODE', $activeConfig['debug']);
define('UPLOAD_PATH', $activeConfig['upload_path']);
define('APP_TIMEZONE', $activeConfig['timezone']);

// Configurar zona horaria
date_default_timezone_set(APP_TIMEZONE);

// Configurar manejo de errores según ambiente
if (DEBUG_MODE) {
    // Desarrollo: Mostrar todos los errores
    error_reporting(E_ALL);
    ini_set('display_errors', '1');
    ini_set('display_startup_errors', '1');
} else {
    // Producción: No mostrar errores (guardar en logs)
    error_reporting(E_ALL);
    ini_set('display_errors', '0');
    ini_set('display_startup_errors', '0');
    ini_set('log_errors', '1');
    ini_set('error_log', __DIR__ . '/../logs/php_errors.log');
}

// Información del ambiente (para debugging)
function getEnvironmentInfo() {
    return [
        'environment' => ENVIRONMENT,
        'db_host' => DB_HOST,
        'db_name' => DB_NAME,
        'base_url' => BASE_URL,
        'debug_mode' => DEBUG_MODE,
        'timezone' => APP_TIMEZONE,
        'php_version' => PHP_VERSION
    ];
}

// Función helper para URLs
function url($path = '') {
    return BASE_URL . ltrim($path, '/');
}

// Función helper para verificar si estamos en producción
function isProduction() {
    return ENVIRONMENT === 'production';
}

// Función helper para verificar si estamos en desarrollo
function isDevelopment() {
    return ENVIRONMENT === 'development';
}
?>

