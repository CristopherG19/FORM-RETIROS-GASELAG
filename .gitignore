backups/database/daily/*.zip
backups/database/weekly/*.sql
backups/database/weekly/*.zip
backups/database/monthly/*.sql
backups/database/monthly/*.zip

backups/uploads_backup/daily/*.zip
backups/uploads_backup/weekly/*.zip
backups/uploads_backup/monthly/*.zip

# Mantener estructura de carpetas pero no contenido
!backups/database/daily/.gitkeep
!backups/database/weekly/.gitkeep
!backups/database/monthly/.gitkeep
!backups/uploads_backup/daily/.gitkeep
!backups/uploads_backup/weekly/.gitkeep
!backups/uploads_backup/monthly/.gitkeep

